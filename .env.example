# Just CS Planner — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# Never commit real secrets. This file contains placeholders only.
#
# See docs/NOTIFICATIONS.md for the email (Resend) and LINE setup walkthrough.

# ─── Data backend ───────────────────────────────────────────────────────────
# "mock" = in-memory dev data; "sheets" = Google Sheet adapter.
DATA_BACKEND=mock

# ─── Google Sheets (required when DATA_BACKEND=sheets) ──────────────────────
# Path to the service-account JSON key file (absolute or cwd-relative).
GOOGLE_APPLICATION_CREDENTIALS=
# The spreadsheet ID hosting the JobCards / Team / Notifications tabs.
GOOGLE_SHEETS_SPREADSHEET_ID=

# ─── Scheduled scans / cron ─────────────────────────────────────────────────
# Shared secret that callers of /api/cron/* must send via the
# `Authorization: Bearer <CRON_SECRET>` header.
CRON_SECRET=

# ─── Email channel (Resend) — optional ──────────────────────────────────────
# Both values are required for email delivery. When omitted, the email channel
# is not registered and the app stays in-app-only.
# Sign up at https://resend.com, verify your sending domain, then set these.
# API key (starts with `re_`).
RESEND_API_KEY=
# Verified sender address, e.g. onboarding@yourdomain.com or
# "Just CS Planner <onboarding@yourdomain.com>".
NOTIFY_EMAIL_FROM=onboarding@yourdomain.com

# ─── LINE channel — optional ────────────────────────────────────────────────
# Required for LINE delivery. When LINE_CHANNEL_ACCESS_TOKEN is omitted, the
# LINE channel is not registered.
# Channel access token from your LINE Official Account (LINE Developers console).
LINE_CHANNEL_ACCESS_TOKEN=
# The target id to push messages to: a user id, group id, or room id.
# First cut: a single broadcast target for the whole CS team.
# Per-user LINE targeting is a future enhancement.
LINE_TARGET_ID=
